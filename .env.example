# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored — never commit it. docker-compose loads it for both
# the `ui` and `backend` services (see docker-compose.yml's env_file).

# ── Backend (services/api/app/core/config.py) ──────────────
APP_NAME="AI Engineering API"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
# Local/dev default is SQLite; point this at Supabase (or any Postgres)
# for anything beyond the TinyDB-backed entities. Use the psycopg2
# driver explicitly: postgresql+psycopg2://..., not plain postgresql://.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Must include every origin that calls the API from a browser — the
# website (3000) and the backoffice (3001) under this Docker setup.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
RESEND_API_KEY=
RESEND_FROM_EMAIL="Brasaland <onboarding@resend.dev>"
BACKOFFICE_URL=http://localhost:3001

# ── Frontend (uis/backoffice) ───────────────────────────────
# NEXT_PUBLIC_API_URL: used as a fallback, and by anything that ends up
# running in the browser — must be reachable from the HOST machine.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# BACKEND_INTERNAL_URL: used by the backoffice's own server-side route
# handlers (app/api/proxy/**) — these run inside the `ui` container, so
# they must reach the backend by its Docker service name, not localhost.
BACKEND_INTERNAL_URL=http://backend:8000/api/v1
