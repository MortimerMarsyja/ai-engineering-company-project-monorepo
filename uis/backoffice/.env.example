# Backend API base URL (proxied by uis/backoffice/app/api/proxy/**).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Where lib/telemetry.ts sends batched events, e.g. the backend's ingestion
# endpoint (see services/api/app/routers/telemetry.py):
#   http://localhost:8000/api/v1/telemetry/events
# Optional: when unset, telemetry delivery is disabled gracefully (events
# are still queued/discarded locally, nothing is sent, and the app keeps
# working normally — see docs/event-delivery-strategy.md).
NEXT_PUBLIC_TELEMETRY_ENDPOINT=
